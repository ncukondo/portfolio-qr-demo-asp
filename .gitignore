# Keep shared VS Code config but ignore user-local
# (launch.json / tasks.json are intentionally committed)
.vscode/*.local.json

# Keep shared Claude Code config (.claude/settings.json) but ignore
# per-developer permission overrides in .claude/settings.local.json
.claude/settings.local.json

